---
import quotes from '../data/quotes.data.json';

interface Props {
  category?: string | null;
}

const { category = null } = Astro.props;
---

<div class="random-quote" data-category={category ?? ''}>
  <p class="quote-text"></p>
  <p class="quote-author"></p>
</div>

<script>
  import quotes from '../data/quotes.data.json';

  function displayRandomQuotes() {
    document.querySelectorAll<HTMLElement>('.random-quote').forEach((widget) => {
      const category = widget.dataset.category;
      const entries = category
        ? quotes.filter((entry) => entry.category === category)
        : quotes;

      if (entries.length === 0) return;

      const selected = entries[Math.floor(Math.random() * entries.length)];
      const text = widget.querySelector('.quote-text');
      const author = widget.querySelector('.quote-author');

      if (text) text.textContent = selected.quote;
      if (author) author.textContent = selected.author || '';
    });
  }

  displayRandomQuotes();
</script>
