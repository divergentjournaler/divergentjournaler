  "html": "<!-- wp:image {\"id\":255,\"width\":\"400px\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} -->\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/BC569134-0FE5-4DBD-9B31-A97FF938FA9A-1.png\" alt=\"31+ Fun Journaling Prompts\" class=\"wp-image-255\" style=\"width:400px\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:separator {\"className\":\"is-style-dots\"} -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-dots\"/>\n<!-- /wp:separator -->\n\n<!-- wp:paragraph -->\n<p>These fun journaling prompts are meant to inspire self-discovery and reflection while adding an element of enjoyment to your journaling practice. Remember, your journal page is your own. The key is having fun and enjoying your time with the page. Click <a href=\"#list\">here</a> to skip past the images and see only a text list.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:gallery {\"linkTo\":\"none\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped\"><!-- wp:image {\"id\":289,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/dj-journal-prompt-images01.png\" alt=\"\" class=\"wp-image-289\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":292,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/2.png\" alt=\"\" class=\"wp-image-292\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":293,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/3.png\" alt=\"\" class=\"wp-image-293\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":295,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/4-1.png\" alt=\"\" class=\"wp-image-295\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":296,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/5-2.png\" alt=\"\" class=\"wp-image-296\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":297,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/6-1.png\" alt=\"\" class=\"wp-image-297\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":298,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/7-1.png\" alt=\"\" class=\"wp-image-298\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":299,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/8-1.png\" alt=\"\" class=\"wp-image-299\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":300,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjou