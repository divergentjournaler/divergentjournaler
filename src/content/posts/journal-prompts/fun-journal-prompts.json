journaler.com/wp-content/uploads/2023/11/15-1.png\" alt=\"\" class=\"wp-image-306\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":307,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/16-1.png\" alt=\"\" class=\"wp-image-307\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":308,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/17-1.png\" alt=\"\" class=\"wp-image-308\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":309,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/18-1.png\" alt=\"\" class=\"wp-image-309\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":310,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/19-1.png\" alt=\"\" class=\"wp-image-310\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":311,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/20.png\" alt=\"\" class=\"wp-image-311\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":312,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/21.png\" alt=\"\" class=\"wp-image-312\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":313,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/22.png\" alt=\"\" class=\"wp-image-313\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":314,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/23.png\" alt=\"\" class=\"wp-image-314\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":315,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/24.png\" alt=\"\" class=\"wp-image-315\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":317,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/25.png\" alt=\"\" class=\"wp-image-317\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":320,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/26.png\" alt=\"\" class=\"wp-image-320\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":319,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/27.png\" alt=\"\" class=\"wp-image-319\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":322,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/28.png\" alt=\"\" class=\"wp-image-322\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":323,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/29.png\" alt=\"\" class=\"wp-image-323\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":324,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/30.png\" alt=\"\" class=\"wp-image-324\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":325,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/31.png\" alt=\"\" class=\"wp-image-325\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":326,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/32.png\" alt=\"\" class=\"wp-image-326\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":327,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/33.png\" alt=\"\" class=\"wp-image-327\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":328,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/34.png\" alt=\"\" class=\"wp-image-328\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":329,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/35.png\" alt=\"\" class=\"wp-image-329\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"id\":330,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"block-gallery-outline\"} -->\n<figure class=\"wp-block-image size-full block-gallery-outline\"><img src=\"https://divergentjournaler.com/wp-content/uploads/2023/11/36.png\" alt=\"\" class=\"wp-image-330\"/></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:separator {\"className\":\"is-style-dots\"} -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-dots\"/>\n<!-- /wp:separator -->\n\n<!-- wp:paragraph -->\n<p id=\"list\">Using prompts is a fun and helpful way to inspire your journaling journey. The list below is for those who would like to use a text list either to print or save into a notes app. </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Fun Journaling Prompts</h4>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Your favorite day ever spent with someone you love.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Write about something that is not expensive but means alot to you.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe your favorite childhood hiding spot.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe your idea treehouse or fort for you right now.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Who is your favorite superhero? Why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Write the lyrics of your favorite song.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe your perfect day spent alone or with your favorite person.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Who is your favorite actor? Why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Who is your favorite band? Why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe how you would spend an hour with your favorite singer.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Make a list of your top 10 favorite things.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>If you had a time machine.. where would you go?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Write about a silly or quirky habit that you have.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>If you could be invisble for a day... where would you go?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Make a list of songs that make you feel happy or feel like dancing.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Who have you been talking to the most lately? Why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What's something you'd like to get better at?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What food do you wish you had right now?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What movie could you watch over and over?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What is the last thing that you ate?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What was your favorite class in school?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe the most comfortable piece of clothing you have.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What hobby would you like to learn?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe the last video you saw that made you laugh.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe the last meme you saw that made you laugh.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe your favorite book.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What do you do to rewind and relax?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe three places you would like to go.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What is your favorite word and why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What is your favorite number and why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What is your favorite color and why?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>You find a hidden box; what's inside it?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>If your life was a movie; what would it be called?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Describe the last concert you went to.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>What do you wish you were really good at?</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>If you were an animal, what would it be?</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>I hope these prompts inspire you, break any creative blocks, or just give you a moment of fun and enjoyment with your journals! Click <a href=\"https://www.pinterest.com/divergentjournaler\">here</a> to visit my Pinterest and see all of these images and more.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Happy Journaling! <br>Sarah G.</p>\n<!-- /wp:paragraph -->"
}