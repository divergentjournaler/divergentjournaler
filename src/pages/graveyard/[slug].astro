---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import remarkBreaks from 'remark-breaks';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];

  return [{ params: { slug: 'preview' } }];
}

const { slug } = Astro.params;
const filePath = join(process.cwd(), '.graveyard', 'drafts', `${slug}.md`);
const source = readFileSync(filePath, 'utf8');

const match = source.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n/);
const frontmatter = match?.[1] ?? '';
const markdown = match ? source.slice(match[0].length) : source;

const title =
  frontmatter.match(/^title:\s*(.+)$/m)?.[1]?.replace(/^["']|["']$/g, '') ??
  'Untitled Preview';

const publishedDate =
  frontmatter.match(/^date:[ \t]*(.+)$/m)?.[1]
    ?.trim()
    .replace(/^["']|["']$/g, '')
    .split(' ')[0] ?? '';

const featuredImage =
  frontmatter.match(/^featuredImage:[ \t]*(.+)$/m)?.[1]
    ?.trim()
    .replace(/^["']|["']$/g, '') ?? '';

const category =
  frontmatter.match(/^category:[ \\t]*(.+)$/m)?.[1]
    ?.trim()
    .replace(/^["']|["']$/g, '') ?? 'Uncategorized';

const categorySlug = category
  .toLowerCase()
  .trim()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');

const processor = await createMarkdownProcessor({
  remarkPlugins: [remarkBreaks],
});

const { code: html } = await processor.render(markdown);

const firstImage =
  html.match(/<img\b[^>]*\bsrc=["']([^"']+)["']/i)?.[1] ?? '';

const automaticFeaturedImage = !featuredImage && !!firstImage;
const previewFeaturedImage = featuredImage || firstImage;
---

<BaseLayout title={`Preview: ${title}`}>
  <nav slot="page-intro" class="post-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <a href={`/category/${categorySlug}/`}>{category}</a>
  </nav>
  <article class="blog-post">
    {publishedDate && (
      <p class="post-modified">Published: {publishedDate}</p>
    )}
    {previewFeaturedImage && (
      <div class="post-opening-media">
        <img src={previewFeaturedImage} alt={title} />
      </div>
    )}
    <h1 class="post-title">{title}</h1>
    <div class="post-content">
      <div class:list={["markdown-body", { "skip-first-featured-image": automaticFeaturedImage }]} set:html={html} />
    </div>
  </article>
</BaseLayout>
