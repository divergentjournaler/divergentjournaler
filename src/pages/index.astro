---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogFeed from '../components/BlogFeed.astro';
import settings from '../data/site.settings.data.json';
import Pagination from '../components/Pagination.astro';
import { getAllUnifiedArticles } from '../lib/articles';

const allPosts = (await getAllUnifiedArticles())
  .sort((a, b) => b.metadata.date.localeCompare(a.metadata.date));

const totalPages = Math.ceil(
  allPosts.length / settings.blog.postsPerPage
);

const posts = allPosts.slice(0, settings.blog.postsPerPage);
// Change this to refresh cache.
---

<BaseLayout title={settings.general.siteTitle} description={settings.general.homeDescription}>
  <BlogFeed posts={posts} />
  <Pagination currentPage={1} totalPages={totalPages} />
</BaseLayout>