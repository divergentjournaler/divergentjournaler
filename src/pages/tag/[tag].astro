
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogFeed from '../../components/BlogFeed.astro';
import Pagination from '../../components/Pagination.astro';
import settings from '../../data/site.settings.data.json';
import { getAllUnifiedArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const posts = await getAllUnifiedArticles();
  const tags = new Map<string, string>();

  for (const post of posts) {
    for (const tag of post.metadata.tags ?? []) {
      tags.set(tag.slug, tag.name);
    }
  }

  return Array.from(tags, ([slug, name]) => {
    const tagPosts = posts
      .filter((post) =>
        (post.metadata.tags ?? []).some((tag) => tag.slug === slug)
      )
      .sort((a, b) => b.metadata.date.localeCompare(a.metadata.date));

    return {
      params: { tag: slug },
      props: {
        tagName: name,
        tagSlug: slug,
        posts: tagPosts.slice(0, settings.blog.postsPerPage),
        totalPages: Math.ceil(
          tagPosts.length / settings.blog.postsPerPage
        ),
      },
    };
  });
}

const { tagName, tagSlug, posts, totalPages } = Astro.props;
---

<BaseLayout
  title={tagName}
  description={`Browse content tagged ${tagName} at ${settings.general.siteTitle}.`}
>
  <h1 slot="page-intro">Tag : #{tagName}</h1>
  <BlogFeed posts={posts} />
  <Pagination
    currentPage={1}
    totalPages={totalPages}
    basePath={`/tag/${tagSlug}/`}
  />
</BaseLayout>
