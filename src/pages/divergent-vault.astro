
---
import BaseLayout from '../layouts/BaseLayout.astro';
import vaultHtml from '../content/divergent-vault.html?raw';
import settings from '../data/site.settings.data.json';

// Extract the original image and remove it from the article body.
const imageMatch = vaultHtml.match(/<figure\b[\s\S]*?<\/figure>/);
const featuredImage = imageMatch?.[0] ?? '';
const articleHtml = featuredImage
  ? vaultHtml.replace(featuredImage, '')
  : vaultHtml;

const finalHtml = articleHtml;
---

<BaseLayout title="Divergent Vault" description={settings.general.vaultDescription}>
  <nav slot="page-intro" class="post-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <a href="/divergent-vault/" aria-current="page">Divergent Vault</a>
  </nav>

  <article class="blog-post">
    <p class="post-modified">
      Published: 2024-01-04
    </p>

    {featuredImage && (
      <div class="post-opening-media" set:html={featuredImage} />
    )}

    <h1 class="post-title">Divergent Vault</h1>

    <div class="post-content">
      <div class="divergent-vault" set:html={finalHtml} />
    </div>
  </article>
</BaseLayout>
